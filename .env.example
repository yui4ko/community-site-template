# The URL to your database. In Docker, this is handled automatically.
# Local development only:
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_random_secret_string_here"

# Default Admin Account (Used to initialize your first admin user)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# Public Site URL (used for calendar links, SEO, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Social Links (Leave empty to hide icons)
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/yourcompany"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/yourcompany"
